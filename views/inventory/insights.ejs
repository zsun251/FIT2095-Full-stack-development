<%- include('../partials/header') %>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1><i class="fas fa-brain text-success"></i> Intelligent Inventory Management</h1>
            <p class="text-muted">Advanced analytics to optimize purchasing decisions, reduce waste, and track cost efficiency</p>
        </div>
    </div>

    <!-- Expiration Waste Analysis -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h5><i class="fas fa-exclamation-triangle"></i> Expiration Waste Analysis</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <!-- Items Expiring Soon -->
                            <h6 class="text-danger"><i class="fas fa-clock"></i> Items Expiring in 3 Days (Total Value: $<%= expirationWasteAnalysis.totalWasteValue.toFixed(2) %>)</h6>
                            <% if (expirationWasteAnalysis.expiringItems && expirationWasteAnalysis.expiringItems.length > 0) { %>
                                <% expirationWasteAnalysis.expiringItems.forEach(item => { %>
                                    <div class="d-flex justify-content-between py-1">
                                        <div>
                                            <span><%= item.ingredientName %></span>
                                            <br><small class="text-muted"><%= item.category %> • <%= item.quantity %> <%= item.unit %></small>
                                        </div>
                                        <div class="text-end">
                                            <span class="text-danger"><%= item.daysUntilExpiry %> day<%= item.daysUntilExpiry !== 1 ? 's' : '' %></span>
                                            <br><small class="text-muted">$<%= item.wasteValue.toFixed(2) %> value</small>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-muted small">No items expiring in the next 3 days.</p>
                            <% } %>
                        </div>

                        <div class="col-md-6">
                            <!-- Use Soon Recipe Suggestions -->
                            <h6 class="text-warning"><i class="fas fa-utensils"></i> "Use Soon" Recipe Suggestions</h6>
                            <% if (expirationWasteAnalysis.useSoonRecipes && expirationWasteAnalysis.useSoonRecipes.length > 0) { %>
                                <% expirationWasteAnalysis.useSoonRecipes.forEach(recipe => { %>
                                    <div class="d-flex justify-content-between py-1">
                                        <div>
                                            <span><%= recipe.title %></span>
                                            <br><small class="text-muted">by <%= recipe.chef %> • <%= recipe.cuisineType %></small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-warning"><%= recipe.expiringIngredientsUsed %> expiring</span>
                                            <br><small class="text-muted"><%= Math.round(recipe.expiringIngredientRatio * 100) %>% match</small>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-muted small">No recipe suggestions for expiring ingredients.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cost Efficiency & Smart Reordering -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5><i class="fas fa-chart-line"></i> Cost Efficiency & Reordering Intelligence</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <!-- Cost Efficiency Tracking -->
                            <h6 class="text-primary"><i class="fas fa-dollar-sign"></i> Cost Trends (Last 30 vs Previous 30 Days)</h6>
                            <% if (costEfficiencyTracking && costEfficiencyTracking.length > 0) { %>
                                <% costEfficiencyTracking.forEach(category => { %>
                                    <div class="d-flex justify-content-between py-1">
                                        <div>
                                            <span><%= category._id %></span>
                                            <br><small class="text-muted">
                                                $<%= category.current ? category.current.avgCostPerUnit.toFixed(2) : '0.00' %>/unit avg
                                            </small>
                                        </div>
                                        <div class="text-end">
                                            <% if (category.costTrend > 0) { %>
                                                <span class="text-danger"><i class="fas fa-arrow-up"></i> +$<%= category.costTrend.toFixed(2) %></span>
                                            <% } else if (category.costTrend < 0) { %>
                                                <span class="text-success"><i class="fas fa-arrow-down"></i> $<%= category.costTrend.toFixed(2) %></span>
                                            <% } else { %>
                                                <span class="text-muted">No change</span>
                                            <% } %>
                                            <br><small class="text-muted">
                                                $<%= category.current ? category.current.totalSpent.toFixed(2) : '0.00' %> spent
                                            </small>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-muted small">No cost tracking data available.</p>
                            <% } %>
                        </div>

                        <div class="col-md-6">
                            <!-- Smart Reordering -->
                            <h6 class="text-info"><i class="fas fa-shopping-cart"></i> Smart Reordering Suggestions</h6>
                            <% if (smartReordering && smartReordering.length > 0) { %>
                                <% smartReordering.slice(0, 6).forEach(item => { %>
                                    <div class="d-flex justify-content-between py-1">
                                        <div>
                                            <span><%= item._id %></span>
                                            <br><small class="text-muted">
                                                Stock: <%= item.currentStock.toFixed(1) %> • Est. <%= Math.round(item.estimatedDaysLeft) %> days left
                                            </small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-<%= item.reorderPriority === 'High' ? 'danger' : item.reorderPriority === 'Medium' ? 'warning' : 'info' %>">
                                                <%= item.reorderPriority %>
                                            </span>
                                            <br><small class="text-muted">Order <%= Math.round(item.suggestedOrderQuantity) %></small>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-muted small">No reordering suggestions available.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Budget Optimization -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5><i class="fas fa-piggy-bank"></i> Budget Optimization Dashboard</h5>
                </div>
                <div class="card-body">
                    <!-- Inventory Overview -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <div class="alert alert-info">
                                <div class="row text-center">
                                    <div class="col-md-4">
                                        <h4 class="text-primary">$<%= budgetOptimization.inventoryValue.totalValue.toFixed(2) %></h4>
                                        <small>Total Inventory Value</small>
                                    </div>
                                    <div class="col-md-4">
                                        <h4 class="text-success"><%= budgetOptimization.inventoryValue.totalItems %></h4>
                                        <small>Total Items</small>
                                    </div>
                                    <div class="col-md-4">
                                        <h4 class="text-warning">$<%= budgetOptimization.inventoryValue.avgItemValue.toFixed(2) %></h4>
                                        <small>Average Item Value</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <!-- Category Value Analysis -->
                            <h6 class="text-success"><i class="fas fa-chart-pie"></i> Category Value Distribution</h6>
                            <% if (budgetOptimization.categoryAnalysis && budgetOptimization.categoryAnalysis.length > 0) { %>
                                <% budgetOptimization.categoryAnalysis.forEach(category => { %>
                                    <div class="d-flex justify-content-between py-1">
                                        <div>
                                            <span><%= category._id %></span>
                                            <br><small class="text-muted">
                                                <%= category.itemCount %> items • $<%= category.avgCostPerUnit.toFixed(2) %>/unit
                                            </small>
                                        </div>
                                        <div class="text-end">
                                            <span class="text-success">$<%= category.totalValue.toFixed(2) %></span>
                                            <br><small class="text-muted"><%= category.valuePercentage.toFixed(1) %>% of total</small>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-muted small">No category analysis available.</p>
                            <% } %>
                        </div>

                        <div class="col-md-6">
                            <!-- Cost Effectiveness -->
                            <h6 class="text-info"><i class="fas fa-star"></i> Most Cost-Effective Purchases</h6>
                            <% if (budgetOptimization.costEffectiveness && budgetOptimization.costEffectiveness.length > 0) { %>
                                <% budgetOptimization.costEffectiveness.slice(0, 6).forEach(item => { %>
                                    <div class="d-flex justify-content-between py-1">
                                        <div>
                                            <span><%= item.ingredientName %></span>
                                            <br><small class="text-muted">
                                                <%= item.category %> • $<%= item.totalValue.toFixed(2) %> value
                                            </small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-<%= item.costEfficiencyRating === 'Excellent' ? 'success' : item.costEfficiencyRating === 'Good' ? 'primary' : item.costEfficiencyRating === 'Fair' ? 'warning' : 'danger' %>">
                                                <%= item.costEfficiencyRating %>
                                            </span>
                                            <br><small class="text-muted">$<%= item.costPerDay.toFixed(2) %>/day</small>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-muted small">No cost effectiveness data available.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="d-flex gap-2">
                <a href="/api/inventory-<%= studentId %>" class="btn btn-outline-warning">Manage Inventory</a>
                <a href="/api/inventory/add-form-<%= studentId %>" class="btn btn-outline-success">Add New Item</a>
                <% if (locals.currentUser && currentUser.role === 'admin') { %>
                    <a href="/reports" class="btn btn-outline-primary">View Reports</a>
                <% } %>
                <a href="/" class="btn btn-outline-secondary">Dashboard</a>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>