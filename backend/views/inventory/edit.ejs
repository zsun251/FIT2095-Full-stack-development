<%- include('../partials/header', {title: title}) %>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">Edit Inventory Item</h4>
                </div>
                <div class="card-body">
                    <% if (inventory.length === 0) { %>
                        <div class="text-center py-4">
                            <h5>No Inventory Items Available</h5>
                            <p class="text-muted">There are no inventory items to edit.</p>
                            <a href="/api/inventory/add-form-<%= studentId %>" class="btn btn-primary">Add New Item</a>
                        </div>
                    <% } else { %>
                        <div class="mb-3">
                            <label for="inventorySelect" class="form-label">Select Inventory Item:</label>
                            <select class="form-select" id="inventorySelect" onchange="showEditForm()">
                                <option value="">Choose an inventory item to edit...</option>
                                <% inventory.forEach(item => { %>
                                    <option value="<%= item.inventoryId || item.ingredientName %>"
                                            data-name="<%= item.ingredientName %>"
                                            data-user="<%= item.userId %>"
                                            data-category="<%= item.category %>"
                                            data-quantity="<%= item.quantity %>"
                                            data-unit="<%= item.unit %>"
                                            data-location="<%= item.location %>"
                                            data-cost="<%= item.cost %>"
                                            data-purchase="<%= new Date(item.purchaseDate).toISOString().split('T')[0] %>"
                                            data-expiration="<%= new Date(item.expirationDate).toISOString().split('T')[0] %>">
                                        <%= item.ingredientName %> (by <%= item.userId %>)
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <!-- Edit Form -->
                        <div id="editForm" style="display: none;">
                            <form id="updateForm" method="POST">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="ingredientName" class="form-label">Ingredient Name</label>
                                        <input type="text" class="form-control" id="ingredientName" name="ingredientName" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="category" class="form-label">Category</label>
                                        <select class="form-select" id="category" name="category" required>
                                            <option value="">Select Category</option>
                                            <option value="Vegetables">Vegetables</option>
                                            <option value="Fruits">Fruits</option>
                                            <option value="Meat">Meat</option>
                                            <option value="Dairy">Dairy</option>
                                            <option value="Grains">Grains</option>
                                            <option value="Spices">Spices</option>
                                            <option value="Beverages">Beverages</option>
                                            <option value="Frozen">Frozen</option>
                                            <option value="Canned">Canned</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label for="quantity" class="form-label">Quantity</label>
                                        <input type="number" class="form-control" id="quantity" name="quantity" step="0.01" min="0.01" max="9999" required>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label for="unit" class="form-label">Unit</label>
                                        <select class="form-select" id="unit" name="unit" required>
                                            <option value="">Select Unit</option>
                                            <option value="pieces">Pieces</option>
                                            <option value="kg">Kilograms</option>
                                            <option value="g">Grams</option>
                                            <option value="liters">Liters</option>
                                            <option value="ml">Milliliters</option>
                                            <option value="cups">Cups</option>
                                            <option value="tbsp">Tablespoons</option>
                                            <option value="tsp">Teaspoons</option>
                                            <option value="dozen">Dozen</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label for="location" class="form-label">Location</label>
                                        <select class="form-select" id="location" name="location" required>
                                            <option value="">Select Location</option>
                                            <option value="Fridge">Fridge</option>
                                            <option value="Freezer">Freezer</option>
                                            <option value="Pantry">Pantry</option>
                                            <option value="Counter">Counter</option>
                                            <option value="Cupboard">Cupboard</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label for="cost" class="form-label">Cost ($)</label>
                                        <input type="number" class="form-control" id="cost" name="cost" step="0.01" min="0.01" max="999.99" required>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label for="purchaseDate" class="form-label">Purchase Date</label>
                                        <input type="date" class="form-control" id="purchaseDate" name="purchaseDate" required>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label for="expirationDate" class="form-label">Expiration Date</label>
                                        <input type="date" class="form-control" id="expirationDate" name="expirationDate" required>
                                    </div>
                                </div>

                                <div class="text-center">
                                    <button type="button" class="btn btn-secondary me-2" onclick="resetForm()">Reset</button>
                                    <button type="submit" class="btn btn-primary">Update Item</button>
                                </div>
                            </form>
                        </div>
                    <% } %>
                </div>

                <div class="card-footer text-center">
                    <a href="/api/inventory-<%= studentId %>" class="btn btn-outline-secondary">Back to Inventory</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function showEditForm() {
    const select = document.getElementById('inventorySelect');
    const editForm = document.getElementById('editForm');
    const updateForm = document.getElementById('updateForm');

    if (select.value) {
        const option = select.selectedOptions[0];

        // Populate form fields
        document.getElementById('ingredientName').value = option.dataset.name;
        document.getElementById('category').value = option.dataset.category;
        document.getElementById('quantity').value = option.dataset.quantity;
        document.getElementById('unit').value = option.dataset.unit;
        document.getElementById('location').value = option.dataset.location;
        document.getElementById('cost').value = option.dataset.cost;
        document.getElementById('purchaseDate').value = option.dataset.purchase;
        document.getElementById('expirationDate').value = option.dataset.expiration;

        // Set form action
        updateForm.action = `/api/inventory/update-<%= studentId %>/${option.value}`;

        // Show form
        editForm.style.display = 'block';
    } else {
        editForm.style.display = 'none';
    }
}

function resetForm() {
    document.getElementById('inventorySelect').value = '';
    showEditForm();
}
</script>

<%- include('../partials/footer') %>