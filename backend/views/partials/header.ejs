<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Recipe Hub</title>
    <!-- Bootstrap CSS -->
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="/image/logo.jpeg" alt="Recipe Hub Logo" class="logo-img me-2">
                <span>Recipe Hub</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <% if (locals.currentUser) { %>
                        <!-- Simple navigation links without dropdowns -->
                        <% if (currentUser.role === 'chef') { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/api/recipes">
                                    <i class="fas fa-utensils"></i> Recipes
                                </a>
                            </li>
                        <% } %>

                        <li class="nav-item">
                            <a class="nav-link" href="/api/inventory">
                                <i class="fas fa-boxes"></i> Inventory
                            </a>
                        </li>

                        <% if (currentUser.role === 'admin') { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/reports">
                                    <i class="fas fa-chart-bar"></i> Reports
                                </a>
                            </li>
                        <% } %>

                        <li class="nav-item">
                            <a class="nav-link" href="/logout" onclick="return confirm('Are you sure you want to logout?')">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/register">Register</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>