<%- include('../partials/header') %>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1><i class="fas fa-lightbulb text-warning"></i> Recipe Recommendations</h1>
            <p class="text-muted">Smart suggestions based on your inventory and popular recipes</p>
        </div>
    </div>

    <!-- Recipe Matches based on Inventory -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5><i class="fas fa-utensils"></i> Recipes You Can Make (≥ 50% ingredients available)</h5>
                </div>
                <div class="card-body">
                    <% if (recipeMatches && recipeMatches.length > 0) { %>
                        <div class="row">
                            <% recipeMatches.forEach(recipe => { %>
                                <div class="col-md-6 mb-3">
                                    <div class="card border-success">
                                        <div class="card-body">
                                            <h6 class="card-title"><%= recipe.title %></h6>
                                            <p class="text-muted mb-2">by <%= recipe.chef %></p>
                                            <div class="progress mb-2">
                                                <div class="progress-bar bg-success">
                                                    <%= recipe.cookabilityScore %>% cookable
                                                </div>
                                            </div>
                                            <small class="text-muted">
                                                <%= recipe.availableIngredients %>/<%= recipe.totalIngredients %> ingredients available
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-muted">No recipes found with sufficient ingredient availability.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Popular Recipes -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5><i class="fas fa-fire"></i> Popular Recipes</h5>
                </div>
                <div class="card-body">
                    <% if (popularRecipes && popularRecipes.length > 0) { %>
                        <% popularRecipes.forEach(recipe => { %>
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <div>
                                    <strong><%= recipe.title %></strong>
                                    <br><small class="text-muted">
                                        by <% if (recipe.allChefs && recipe.allChefs.length > 1) { %>
                                            <%= recipe.allChefs.join(', ') %>
                                        <% } else { %>
                                            <%= recipe.chef %>
                                        <% } %>
                                    </small>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-primary"><%= recipe.difficulty %></span>
                                    <br><small class="text-muted"><%= recipe.count || 1 %> times created</small>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-muted">No popular recipes found.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Inventory Alerts -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5><i class="fas fa-exclamation-triangle"></i> Inventory Alerts</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <!-- Low Stock -->
                            <h6 class="text-danger"><i class="fas fa-arrow-down"></i> Low Stock Items</h6>
                            <% if (lowStock && lowStock.length > 0) { %>
                                <% lowStock.forEach(item => { %>
                                    <div class="d-flex justify-content-between py-1">
                                        <span><%= item.ingredientName %></span>
                                        <span class="text-danger"><%= item.quantity %> left</span>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-muted small">No low stock items.</p>
                            <% } %>
                        </div>

                        <div class="col-md-6">
                            <!-- Expiring Soon -->
                            <h6 class="text-warning"><i class="fas fa-clock"></i> Expiring Soon</h6>
                            <% if (expiringSoon && expiringSoon.length > 0) { %>
                                <% expiringSoon.forEach(item => { %>
                                    <div class="d-flex justify-content-between py-1">
                                        <span><%= item.ingredientName %></span>
                                        <span class="text-warning small">
                                            <%= new Date(item.expirationDate).toLocaleDateString() %>
                                        </span>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-muted small">No items expiring soon.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="d-flex gap-2">
                <a href="/api/recipes-<%= studentId %>" class="btn btn-outline-primary">Back to Recipes</a>
                <a href="/api/inventory-<%= studentId %>" class="btn btn-outline-warning">Manage Inventory</a>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>