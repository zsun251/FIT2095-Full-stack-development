<%- include('../partials/header', {title: title}) %>

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="text-gradient mb-0">
                        <%= title %>
                    </h2>
                    <!-- Recipe View Toggle Buttons -->
                    <div class="btn-group mt-2" role="group" aria-label="Recipe view toggle">
                        <a href="/api/recipes-<%= studentId %>" class="btn btn-<%= showAll ? 'primary' : 'outline-primary' %>">
                            All Recipes
                        </a>
                        <a href="/api/recipes/my-recipes-<%= studentId %>" class="btn btn-<%= !showAll ? 'primary' : 'outline-primary' %>">
                            My Recipes
                        </a>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <!-- Primary Actions -->
                    <a href="/api/recipes/add-form-<%= studentId %>" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Add Recipe
                    </a>

                    <!-- Management Actions -->
                    <a href="/api/recipes/edit-form-<%= studentId %>" class="btn btn-outline-warning">
                        <i class="fas fa-edit"></i> Edit Recipe
                    </a>
                    <a href="/api/recipes/delete-form-<%= studentId %>" class="btn btn-outline-danger">
                        <i class="fas fa-trash"></i> Delete Recipe
                    </a>

                    <!-- Navigation -->
                    <a href="/" class="btn btn-outline-secondary">
                        <i class="fas fa-home"></i> Home
                    </a>
                </div>
            </div>

            <!-- Recipes Table -->
            <div class="card shadow-soft rounded-lg">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        Recipe Collection
                    </h5>
                </div>
                <div class="card-body p-0">
                    <% if (recipes.length === 0) { %>
                        <div class="text-center py-5">
                            <h4 class="text-muted">No Recipes Found</h4>
                            <p class="text-muted mb-4">Start building your recipe collection by adding your first recipe!</p>
                            <a href="/api/recipes/add-form-<%= studentId %>" class="btn btn-primary">
                                Add Your First Recipe
                            </a>
                        </div>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0" style="font-size: 0.9rem;">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col" class="text-center" style="width: 3%;">#</th>
                                        <th scope="col" style="width: 15%;">Recipe Title</th>
                                        <th scope="col" style="width: 10%;">Chef</th>
                                        <th scope="col" style="width: 8%;">Cuisine</th>
                                        <th scope="col" style="width: 8%;">Meal Type</th>
                                        <th scope="col" style="width: 20%;">Ingredients</th>
                                        <th scope="col" style="width: 20%;">Instructions</th>
                                        <th scope="col" class="text-center" style="width: 6%;">Prep Time</th>
                                        <th scope="col" class="text-center" style="width: 6%;">Difficulty</th>
                                        <th scope="col" class="text-center" style="width: 4%;">Servings</th>
                                        <th scope="col" class="text-center" style="width: 8%;">Created</th>
                                        <th scope="col" class="text-center" style="width: 10%;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recipes.forEach((recipe, index) => { %>
                                        <tr style="vertical-align: top;">
                                            <td class="text-center fw-bold text-primary" style="padding: 8px;"><%= index + 1 %></td>
                                            <td style="padding: 8px;">
                                                <div class="fw-bold text-dark" style="font-size: 0.85rem;"><%= recipe.title %></div>
                                                <small class="text-muted" style="font-size: 0.7rem;">ID: <%= recipe.recipeId %></small>
                                            </td>
                                            <td style="padding: 8px; font-size: 0.8rem;"><%= recipe.chef %></td>
                                            <td style="padding: 8px;">
                                                <span class="badge bg-info" style="font-size: 0.7rem;"><%= recipe.cuisineType %></span>
                                            </td>
                                            <td style="padding: 8px;">
                                                <span class="badge
                                                    <% if (recipe.mealType === 'Breakfast') { %>bg-warning<% }
                                                       else if (recipe.mealType === 'Lunch') { %>bg-success<% }
                                                       else if (recipe.mealType === 'Dinner') { %>bg-primary<% }
                                                       else { %>bg-secondary<% } %>" style="font-size: 0.7rem;">
                                                    <%= recipe.mealType %>
                                                </span>
                                            </td>
                                            <td style="padding: 8px; font-size: 0.75rem;">
                                                <% if (recipe.ingredients && recipe.ingredients.length > 0) { %>
                                                    <% recipe.ingredients.slice(0, 3).forEach((ingredient, i) => { %>
                                                        <div class="mb-1">• <%= ingredient.length > 25 ? ingredient.substring(0, 25) + '...' : ingredient %></div>
                                                    <% }); %>
                                                    <% if (recipe.ingredients.length > 3) { %>
                                                        <small class="text-muted">+<%= recipe.ingredients.length - 3 %> more</small>
                                                    <% } %>
                                                <% } else { %>
                                                    <span class="text-muted">No ingredients</span>
                                                <% } %>
                                            </td>
                                            <td style="padding: 8px; font-size: 0.75rem;">
                                                <% if (recipe.instructions && recipe.instructions.length > 0) { %>
                                                    <% recipe.instructions.slice(0, 2).forEach((instruction, i) => { %>
                                                        <div class="mb-1"><%= i + 1 %>. <%= instruction.length > 30 ? instruction.substring(0, 30) + '...' : instruction %></div>
                                                    <% }); %>
                                                    <% if (recipe.instructions.length > 2) { %>
                                                        <small class="text-muted">+<%= recipe.instructions.length - 2 %> more steps</small>
                                                    <% } %>
                                                <% } else { %>
                                                    <span class="text-muted">No instructions</span>
                                                <% } %>
                                            </td>
                                            <td class="text-center" style="padding: 8px;">
                                                <span class="fw-bold" style="font-size: 0.8rem;"><%= recipe.prepTime %></span><br>
                                                <small class="text-muted" style="font-size: 0.7rem;">min</small>
                                            </td>
                                            <td class="text-center" style="padding: 8px;">
                                                <span class="badge
                                                    <% if (recipe.difficulty === 'Easy') { %>bg-success<% }
                                                       else if (recipe.difficulty === 'Medium') { %>bg-warning<% }
                                                       else { %>bg-danger<% } %>" style="font-size: 0.7rem;">
                                                    <%= recipe.difficulty %>
                                                </span>
                                            </td>
                                            <td class="text-center" style="padding: 8px;">
                                                <span class="fw-bold" style="font-size: 0.8rem;"><%= recipe.servings %></span>
                                            </td>
                                            <td class="text-center" style="padding: 8px;">
                                                <small class="text-muted" style="font-size: 0.7rem;">
                                                    <%= new Date(recipe.createdDate).toLocaleDateString() %>
                                                </small>
                                            </td>
                                            <td class="text-center" style="padding: 8px;">
                                                <div class="d-flex flex-column gap-1">
                                                    <a href="/api/recipes/edit-<%= studentId %>/<%= recipe.recipeId %>"
                                                       class="btn btn-xs btn-outline-primary" style="font-size: 0.7rem; padding: 2px 6px;">Edit</a>
                                                    <form action="/api/recipes/delete-<%= studentId %>/<%= recipe.recipeId %>"
                                                          method="POST" class="d-inline"
                                                          onsubmit="return confirm('Are you sure you want to delete this recipe: <%= recipe.title %>?')">
                                                        <button type="submit" class="btn btn-xs btn-outline-danger" style="font-size: 0.7rem; padding: 2px 6px;">Delete</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Summary Footer -->
            <% if (recipes.length > 0) { %>
                <div class="mt-4 text-center">
                    <p class="text-muted">
                        Showing <%= recipes.length %> recipe<%= recipes.length !== 1 ? 's' : '' %> in your collection
                    </p>
                </div>
            <% } %>
        </div>
    </div>
</div>



<%- include('../partials/footer') %>