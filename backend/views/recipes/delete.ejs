<%- include('../partials/header', {title: title}) %>

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-danger text-white text-center">
                    <h4 class="mb-0">Delete Recipe</h4>
                </div>
                <div class="card-body">
                    <% if (recipes.length === 0) { %>
                        <div class="text-center py-4">
                            <h5>No Recipes Available</h5>
                            <p class="text-muted">There are no recipes to delete.</p>
                            <a href="/api/recipes/add-form-<%= studentId %>" class="btn btn-primary">Add New Recipe</a>
                        </div>
                    <% } else { %>
                        <div class="mb-3">
                            <label for="recipeSelect" class="form-label">Select Recipe:</label>
                            <select class="form-select" id="recipeSelect" onchange="showDetails()">
                                <option value="">Choose a recipe to delete...</option>
                                <% recipes.forEach(recipe => { %>
                                    <option value="<%= recipe.recipeId %>" 
                                            data-title="<%= recipe.title %>"
                                            data-chef="<%= recipe.chef %>"
                                            data-cuisine="<%= recipe.cuisineType %>"
                                            data-difficulty="<%= recipe.difficulty %>"
                                            data-meal="<%= recipe.mealType %>"
                                            data-prep="<%= recipe.prepTime %>"
                                            data-servings="<%= recipe.servings %>">
                                        <%= recipe.title %> (by <%= recipe.chef %>)
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <!-- Recipe Details -->
                        <div id="recipeDetails" style="display: none;" class="mb-3">
                            <div class="alert alert-info">
                                <h6>Recipe Details:</h6>
                                <p class="mb-1"><strong id="detailTitle"></strong> by <span id="detailChef"></span></p>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p class="mb-1">ID: <span id="detailId" class="text-primary fw-bold"></span></p>
                                        <p class="mb-1">Cuisine: <span id="detailCuisine"></span></p>
                                        <p class="mb-0">Meal Type: <span id="detailMeal"></span></p>
                                    </div>
                                    <div class="col-md-6">
                                        <p class="mb-1">Difficulty: <span id="detailDifficulty"></span></p>
                                        <p class="mb-1">Prep Time: <span id="detailPrep"></span> minutes</p>
                                        <p class="mb-0">Servings: <span id="detailServings"></span></p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Confirmation Dialog -->
                        <div id="confirmDialog" style="display: none;">
                            <div class="alert alert-warning">
                                <strong>Warning:</strong> This will permanently delete "<span id="confirmTitle"></span>". This action cannot be undone.
                            </div>
                            
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="confirmCheck" onchange="toggleButton()">
                                <label class="form-check-label text-danger fw-bold" for="confirmCheck">
                                    I understand and want to permanently delete this recipe
                                </label>
                            </div>
                        </div>
                    <% } %>
                </div>
                
                <div class="card-footer text-center">
                    <a href="/api/recipes-<%= studentId %>" class="btn btn-secondary me-2">← Back to Recipes</a>
                    <% if (recipes.length > 0) { %>
                        <button type="button" class="btn btn-outline-info me-2" onclick="resetForm()" style="display: none;" id="resetBtn">Reset</button>
                        <form id="deleteForm" method="POST" style="display: inline;">
                            <button type="submit" id="deleteBtn" class="btn btn-danger" disabled>
                                Delete Recipe
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function showDetails() {
    const select = document.getElementById('recipeSelect');
    const details = document.getElementById('recipeDetails');
    const dialog = document.getElementById('confirmDialog');
    const resetBtn = document.getElementById('resetBtn');
    const deleteForm = document.getElementById('deleteForm');
    
    if (select.value) {
        const option = select.selectedOptions[0];
        
        // Show recipe details
        document.getElementById('detailTitle').textContent = option.dataset.title;
        document.getElementById('detailChef').textContent = option.dataset.chef;
        document.getElementById('detailId').textContent = option.value;
        document.getElementById('detailCuisine').textContent = option.dataset.cuisine;
        document.getElementById('detailMeal').textContent = option.dataset.meal;
        document.getElementById('detailDifficulty').textContent = option.dataset.difficulty;
        document.getElementById('detailPrep').textContent = option.dataset.prep;
        document.getElementById('detailServings').textContent = option.dataset.servings;
        
        // Show confirmation
        document.getElementById('confirmTitle').textContent = option.dataset.title;
        
        // Set form action
        deleteForm.action = `/api/recipes/delete/${select.value}`;
        
        // Show elements
        details.style.display = 'block';
        dialog.style.display = 'block';
        resetBtn.style.display = 'inline-block';
        
        // Reset form
        document.getElementById('confirmCheck').checked = false;
        document.getElementById('deleteBtn').disabled = true;
    } else {
        details.style.display = 'none';
        dialog.style.display = 'none';
        resetBtn.style.display = 'none';
    }
}

function toggleButton() {
    const deleteBtn = document.getElementById('deleteBtn');
    const confirmCheck = document.getElementById('confirmCheck');
    deleteBtn.disabled = !confirmCheck.checked;
}

function resetForm() {
    document.getElementById('recipeSelect').value = '';
    showDetails();
}
</script>

<%- include('../partials/footer') %>