<%- include('../partials/header') %>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1><i class="fas fa-chart-line text-primary"></i> Advanced Recipe Analytics</h1>
            <p class="text-muted">Comprehensive analytics dashboard powered by MongoDB aggregation pipelines</p>
        </div>
    </div>

    <!-- Popular Recipe Analysis -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5><i class="fas fa-fire"></i> Popular Recipe Analysis by Cuisine</h5>
                </div>
                <div class="card-body">
                    <% if (popularRecipeAnalysis && popularRecipeAnalysis.length > 0) { %>
                        <div class="row">
                            <% popularRecipeAnalysis.forEach(cuisine => { %>
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex justify-content-between py-2 border-bottom">
                                        <div>
                                            <strong><%= cuisine._id %> Cuisine</strong>
                                            <br><small class="text-muted">
                                                <%= cuisine.totalRecipes %> recipes by <%= cuisine.chefCount %> chef<%= cuisine.chefCount !== 1 ? 's' : '' %>
                                            </small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-<%= cuisine.difficultyLabel === 'Easy' ? 'success' : cuisine.difficultyLabel === 'Medium' ? 'warning' : 'danger' %>">
                                                <%= cuisine.difficultyLabel %>
                                            </span>
                                            <br><small class="text-muted">Avg <%= Math.round(cuisine.avgPrepTime) %> min</small>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-muted">No recipe data available for analysis.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Chef Performance & Cost Analysis -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5><i class="fas fa-chart-bar"></i> Chef Performance & Recipe Cost Analysis</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <!-- Chef Performance -->
                            <h6 class="text-primary"><i class="fas fa-chef-hat"></i> Top Performing Chefs</h6>
                            <% if (chefPreferencePatterns && chefPreferencePatterns.length > 0) { %>
                                <% chefPreferencePatterns.slice(0, 5).forEach(chef => { %>
                                    <div class="d-flex justify-content-between py-1">
                                        <div>
                                            <span><%= chef._id %></span>
                                            <br><small class="text-muted">
                                                <%= chef.cuisines.slice(0, 2).join(', ') %>
                                            </small>
                                        </div>
                                        <div class="text-end">
                                            <span class="text-primary"><%= chef.totalRecipes %> recipes</span>
                                            <br><small class="text-muted"><%= Math.round(chef.avgPrepTime) %> min avg</small>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-muted small">No chef data available.</p>
                            <% } %>
                        </div>

                        <div class="col-md-6">
                            <!-- Most Expensive Recipes -->
                            <h6 class="text-success"><i class="fas fa-dollar-sign"></i> Most Expensive Recipes</h6>
                            <% if (ingredientCostImpact && ingredientCostImpact.length > 0) { %>
                                <% ingredientCostImpact.slice(0, 5).forEach(recipe => { %>
                                    <div class="d-flex justify-content-between py-1">
                                        <div>
                                            <span><%= recipe.title.length > 20 ? recipe.title.substring(0, 20) + '...' : recipe.title %></span>
                                            <br><small class="text-muted">by <%= recipe.chef %></small>
                                        </div>
                                        <div class="text-end">
                                            <span class="text-success">$<%= recipe.estimatedCost.toFixed(2) %></span>
                                            <br><small class="text-muted"><%= Math.round(recipe.availabilityPercentage) %>% available</small>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-muted small">No cost analysis data available.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Smart Recipe Suggestions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5><i class="fas fa-lightbulb"></i> Smart Recipe Suggestions (90%+ Available Ingredients)</h5>
                </div>
                <div class="card-body">
                    <% if (smartRecipeSuggestions && smartRecipeSuggestions.length > 0) { %>
                        <div class="row">
                            <% smartRecipeSuggestions.forEach(recipe => { %>
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex justify-content-between py-2 border-bottom">
                                        <div>
                                            <strong><%= recipe.title %></strong>
                                            <br><small class="text-muted">
                                                by <%= recipe.chef %> • <%= recipe.cuisineType %>
                                            </small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-<%= recipe.difficulty === 'Easy' ? 'success' : recipe.difficulty === 'Medium' ? 'warning' : 'danger' %>">
                                                <%= recipe.difficulty %>
                                            </span>
                                            <br><small class="text-success">
                                                <%= Math.round(recipe.availabilityPercentage) %>% available
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-muted">No smart suggestions available with current inventory.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="d-flex gap-2">
                <a href="/api/inventory-<%= studentId %>" class="btn btn-outline-warning">Manage Inventory</a>
                <a href="/api/recipes-<%= studentId %>" class="btn btn-outline-success">View Recipes</a>
                <a href="/" class="btn btn-outline-primary">Dashboard</a>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>