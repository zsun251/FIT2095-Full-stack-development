# Copy this file to .env and fill in your own keys

# MongoDB connection string (defaults to mongodb://localhost:27017/cloudkitchen-pro)
MONGODB_URI=mongodb://localhost:27017/cloudkitchen-pro

# Google Gemini API key (health analysis, translation, and text-to-speech)
GEMINI_API_KEY=

# Secret used to sign login tokens (any long random string, e.g. from: openssl rand -hex 32)
JWT_SECRET=

PORT=3000
